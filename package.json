{
  "name": "picturewall",
  "version": "1.0.0",
  "description": "A music-reactive photo slideshow for big screens at events, weddings, and parties.",
  "main": "main.js",
  "author": "PictureWall",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "npx --yes electron-builder@26 --win"
  },
  "devDependencies": {
    "electron": "^42.4.0"
  },
  "build": {
    "appId": "com.picturewall.app",
    "productName": "PictureWall",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "PictureWall-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PictureWall-setup.exe"
    }
  }
}
